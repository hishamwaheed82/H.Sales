<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <RootNamespace>H.Sales</RootNamespace>
    <AssemblyName>H.Sales.Domain.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Validation" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Localization" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(HPlatformSource)' == 'Project'">
    <ProjectReference Include="$(HPlatformProjectRoot)H.Platform.Domain.Shared\H.Platform.Domain.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HPlatformSource)' == 'Package'">
    <PackageReference Include="H.Platform.Domain.Shared" Version="$(HPlatformPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
    <Content Remove="Localization\**\*.json" />
  </ItemGroup>

</Project>

